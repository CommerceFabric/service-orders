{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MongoDB": "mongodb://$ORDERS_MONGODB_HOST:$ORDERS_MONGODB_PORT" // will be either replaced by userSecrets in dev, or environment variable replacements in production
  },

  "UsersMicroservice": {
    "BaseUrl": "$USERS_MICROSERVICE_SCHEME://$USERS_MICROSERVICE_HOST:$USERS_MICROSERVICE_PORT" // will be either replaced by userSecrets in dev, or environment variable replacements in production
  },

  "ProductsMicroservice": {
    "BaseUrl": "$PRODUCTS_MICROSERVICE_SCHEME://$PRODUCTS_MICROSERVICE_HOST:$PRODUCTS_MICROSERVICE_PORT" // will be either replaced by userSecrets in dev, or environment variable replacements in production
  },

  "OrdersDatabase": "OrdersDb",

  "ProductsServiceBus": {
    "ConnectionString": "$SERVICEBUS_CONNECTION_STRING", // replaced with value in User Secrets in dev, or infra-platform's CI/CD GitHub Actions secrets in production
    "ProductTopic": "products.updates",
    "ProductOrdersSubscription": "products.updates.orders"
  }
}
