# Copy this file to .env and fill in the values. .env is gitignored and must never be committed.

# Azure Entra ID credentials (used by users-microservice and products-microservice for authentication)
COMMERCEFABRIC_AZURE_ENTRA_CLIENT_SECRET= # get this from your Azure Entra ID app registration

# Azure Service Bus connection string (used for product update events)
SERVICEBUS_CONNECTION_STRING= # get this from your Azure Service Bus namespace
